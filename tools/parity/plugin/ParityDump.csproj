<Project Sdk="Microsoft.NET.Sdk">

  <!-- RUSTibites parity dump plugin: a SECOND, independent BepInEx plugin (unique GUID) that
       (a) dumps prefab/serialized constants that exist neither in save files nor in the decompiled C#,
       (b) can pin Time.fixedDeltaTime to 1/simTPS so captures have a frame-rate-independent tick dt.
       It does NOT reference the game assembly: every game type is reached by reflection, so the same
       DLL keeps working across game builds. Build artifacts land under testdata/parity/ (gitignored). -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>ParityDump</AssemblyName>
    <RootNamespace>RUSTibitesParityDump</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\testdata\parity\plugin\bin\</OutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\testdata\parity\plugin\obj\</BaseIntermediateOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The Bibites</GameDir>
    <Managed>$(GameDir)\The Bibites_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.Physics2DModule"><HintPath>$(Managed)\UnityEngine.Physics2DModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
