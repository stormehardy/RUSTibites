// RUSTibites Windows resources for the VIEWER (rustibites-view.exe, shipped as RUSTibites.exe in the tester zip):
// the project icon + version metadata. The CLI has its own file (rustibites.rc) with its own description.
//
// ICON path is relative to this file; rc.exe is invoked with assets/icon as its working directory.

1 ICON "rustibites.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,3,0
 PRODUCTVERSION 0,2,3,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RUSTibites contributors\0"
            VALUE "FileDescription", "RUSTibites - Bibites simulation viewer\0"
            VALUE "FileVersion", "0.2.3\0"
            VALUE "InternalName", "rustibites-view\0"
            VALUE "OriginalFilename", "rustibites-view.exe\0"
            VALUE "ProductName", "RUSTibites\0"
            VALUE "ProductVersion", "0.2.3\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
